# ===== ThzyxBoTS - Configuração =====
# Copie este arquivo para ".env" e preencha os valores.

# Chave da API do OpenRouter (https://openrouter.ai/keys)
# IMPORTANTE: gere uma chave NOVA. Nunca compartilhe a chave em texto puro.
OPENROUTER_API_KEY=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

# Nome exibido da IA
BOT_NAME=ThzyxBoTS

# Prefixo padrão dos comandos (pode ser alterado por grupo com /setprefix)
DEFAULT_PREFIX=/

# Arquivos de banco de dados (sessão do WhatsApp e dados do bot)
SESSION_DB=session.sqlite3
DATA_DB=bot_data.sqlite3

# (Opcional) JIDs de donos/admins globais separados por vírgula. Ex: 5511999999999
OWNERS=
