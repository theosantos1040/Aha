# ===== ThzyxBoTS - Configuração =====
# Copie este arquivo para ".env" e preencha os valores.
# No Render/Railway, cadastre cada linha como variável de ambiente no painel.

# ---------------------------------------------------------------------------
# OBRIGATÓRIO
# ---------------------------------------------------------------------------

# Chave da API do OpenRouter (https://openrouter.ai/keys)
# Sem ela, TODOS os comandos de IA ficam indisponíveis (/ia /analiseia
# /pesquisa /resumir /corrigir /transcrever ...). O resto do bot funciona.
# IMPORTANTE: gere uma chave NOVA e nunca a compartilhe em texto puro.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# CONEXÃO COM O WHATSAPP
# ---------------------------------------------------------------------------

# Como parear:
#   web  -> página no navegador com QR + código (use esta no Render)
#   code -> código de pareamento no terminal
#   qr   -> QR Code no terminal
# Vazio: pergunta ao iniciar; sem terminal interativo, assume "web".
LOGIN_METHOD=web

# Número que recebe o código de pareamento (DDI+DDD+número, só dígitos).
# Com LOGIN_METHOD=web, o código é gerado automaticamente para este número.
PHONE_NUMBER=5524992506307

# Porta do servidor da página de pareamento.
# No Render NÃO defina: a plataforma injeta a PORT sozinha.
PORT=8080

# ---------------------------------------------------------------------------
# IDENTIDADE E PERMISSÕES
# ---------------------------------------------------------------------------

# Nome exibido da IA nas respostas
BOT_NAME=ThzyxBoTS

# Prefixo padrão dos comandos (alterável por grupo com /setprefix)
DEFAULT_PREFIX=/

# Donos globais: números separados por vírgula, só dígitos.
# Eles passam nas checagens de admin mesmo sem ser admin do grupo.
# Ex.: OWNERS=5511999999999,5521888888888
OWNERS=

# ---------------------------------------------------------------------------
# ARMAZENAMENTO
# ---------------------------------------------------------------------------

# Sessão do WhatsApp. ATENÇÃO no Render: o disco é efêmero — sem um disco
# persistente montado, este arquivo some a cada deploy e você precisa parear
# de novo. Aponte para dentro do disco persistente, ex.: /var/data/session.sqlite3
SESSION_DB=session.sqlite3

# Dados do bot (economia, níveis, cargos, configurações dos grupos).
# Mesma observação sobre disco persistente.
DATA_DB=bot_data.sqlite3

# ---------------------------------------------------------------------------
# MODELOS DE IA (opcional — só mexa se souber o que está trocando)
# Todos foram conferidos no catálogo público do OpenRouter.
# ---------------------------------------------------------------------------

# Visão (/analiseia, /ocr, /legenda). Precisa aceitar imagem.
AI_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# Pesquisa (/pesquisa) — modelo de texto.
AI_SEARCH_MODEL=openai/gpt-oss-20b:free

# Transcrição (/transcrever). Precisa aceitar áudio E exige ffmpeg instalado,
# porque o áudio do WhatsApp é OGG/Opus e a API só aceita mp3/wav.
# Dos 38 modelos com entrada de áudio no OpenRouter, este é o único gratuito.
AI_AUDIO_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Geração de imagem (/gerarimagem). CONSOME CRÉDITOS: não existe nenhum
# modelo gratuito de geração de imagem no OpenRouter. Sem crédito na conta,
# o comando responde um aviso explicando isso.
AI_IMAGE_MODEL=google/gemini-2.5-flash-image
